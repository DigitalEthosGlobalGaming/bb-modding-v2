--- a/gpu/CMakeLists.txt
+++ b/gpu/CMakeLists.txt
@@ -252,6 +252,31 @@ else()
     target_link_libraries(bbgpu PUBLIC PkgConfig::X11)
 endif()
 
+# Native code mods (bbmod: hot-loadable Rust/C mods with clean unload, src/runtime_modhost.c).
+# Windows: on when a bbmod checkout is in third_party/bbmod (or BBMOD_DIR); -DBB_MODHOST=OFF leaves
+# it out. Linux (build.sh) is not wired yet.
+set(BBMOD_DIR "${CMAKE_CURRENT_SOURCE_DIR}/../third_party/bbmod" CACHE PATH "bbmod checkout")
+if (WIN32 AND EXISTS "${BBMOD_DIR}/host/include/modhost.h") # Linux: build.sh links bb-probe itself
+    set(BB_MODHOST_DEFAULT ON)
+else()
+    set(BB_MODHOST_DEFAULT OFF)
+endif()
+option(BB_MODHOST "Native code mods (bbmod)" ${BB_MODHOST_DEFAULT})
+if (BB_MODHOST)
+    file(GLOB BBMOD_HOST_SOURCES CONFIGURE_DEPENDS "${BBMOD_DIR}/host/src/*.c")
+    add_library(bbmod_host STATIC ${BBMOD_HOST_SOURCES})
+    set_target_properties(bbmod_host PROPERTIES C_STANDARD 11)
+    target_include_directories(bbmod_host PUBLIC "${BBMOD_DIR}/host/include" "${BBMOD_DIR}/sdk/include")
+    target_compile_definitions(bbmod_host PRIVATE BBM_WITH_ZYDIS=1)
+    target_link_libraries(bbmod_host PRIVATE Zydis::Zydis)
+    target_sources(bbgpu PRIVATE shim/bbport_modui.cpp)
+    target_compile_definitions(bbgpu PRIVATE BB_MODHOST=1)
+    target_link_libraries(bbgpu PUBLIC bbmod_host)
+    message(STATUS "Code mods (bbmod): on, from ${BBMOD_DIR}")
+else()
+    message(STATUS "Code mods (bbmod): off (no ${BBMOD_DIR})")
+endif()
+
 # bbport (Windows): bbgpu is a static library there, so the loader and the HLE runtime are
 # linked here, where CMake knows its dependencies (build.sh builds them with ninja).
 if (WIN32)
@@ -274,6 +299,9 @@ if (WIN32)
             $<$<COMPILE_LANGUAGE:C>:-Wno-error=unused-but-set-global>)
     endif()
     target_include_directories(bb-probe PRIVATE .. ../src)
+    if (BB_MODHOST)
+        target_compile_definitions(bb-probe PRIVATE BB_MODHOST=1)
+    endif()
     target_link_libraries(bb-probe PRIVATE bbgpu atrac9 onecore bcrypt ws2_32 -pthread)
     # The PS4 range (64 GiB - 1 TiB) must stay free: no high-entropy ASLR for heaps and stacks.
     # The guest main thread runs on the process stack: 16 MiB, committed (no stack probes).
diff --git a/gpu/shim/bbport_modui.cpp b/gpu/shim/bbport_modui.cpp
new file mode 100644
index 0000000..561c53a
--- /dev/null
+++ b/gpu/shim/bbport_modui.cpp
@@ -0,0 +1,245 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: native code mods in the overlay (bbmod, src/runtime_modhost.c). While the settings
+// menu is open: a "Mods" window (state, errors, load/unload/reload) and every panel the mods
+// register. Mod notifications show as toasts at any time. Drawn on the present thread inside
+// BbOverlay::Render (imgui_mutex held); the mod host is only try-locked here, so a hot reload
+// running on the game thread costs one overlay frame, never a stall.
+
+#include "bbport_modui.h"
+
+#include <chrono>
+#include <cstdio>
+#include <deque>
+#include <mutex>
+#include <string>
+
+#include "imgui.h"
+#include "modhost.h"
+
+extern "C" modhost* runtime_modhost_get(void);
+extern "C" const char* runtime_modhost_log_path(void);
+
+namespace {
+
+struct Toast {
+    std::string text;
+    std::chrono::steady_clock::time_point until;
+};
+std::mutex toast_mutex;
+std::deque<Toast> toasts;
+
+int BeginPanel(void*, const char* title, const char* mod_id) {
+    char id[320];
+    std::snprintf(id, sizeof(id), "%s##%s", title, mod_id);
+    ImGui::SetNextWindowSize(ImVec2(420.0f, 0.0f), ImGuiCond_FirstUseEver);
+    return ImGui::Begin(id) ? 1 : 0;
+}
+void EndPanel(void*) { ImGui::End(); }
+void Text(void*, const char* text) { ImGui::TextUnformatted(text); }
+int Button(void*, const char* label) { return ImGui::Button(label) ? 1 : 0; }
+int Checkbox(void*, const char* label, int32_t* value) {
+    bool v = *value != 0;
+    const bool changed = ImGui::Checkbox(label, &v);
+    *value = v ? 1 : 0;
+    return changed ? 1 : 0;
+}
+int SliderFloat(void*, const char* label, float* v, float lo, float hi) {
+    return ImGui::SliderFloat(label, v, lo, hi) ? 1 : 0;
+}
+int SliderInt(void*, const char* label, int32_t* v, int32_t lo, int32_t hi) {
+    int x = *v;
+    const bool changed = ImGui::SliderInt(label, &x, lo, hi);
+    *v = x;
+    return changed ? 1 : 0;
+}
+int InputText(void*, const char* label, char* buf, size_t cap) {
+    return ImGui::InputText(label, buf, cap) ? 1 : 0;
+}
+int CollapsingHeader(void*, const char* label) { return ImGui::CollapsingHeader(label) ? 1 : 0; }
+int Combo(void*, const char* label, int32_t* current, const char* items) {
+    int c = *current;
+    const bool changed = ImGui::Combo(label, &c, items);
+    *current = c;
+    return changed ? 1 : 0;
+}
+void TextColored(void*, float r, float g, float b, float a, const char* text) {
+    ImGui::TextColored(ImVec4(r, g, b, a), "%s", text);
+}
+void Separator(void*) { ImGui::Separator(); }
+void SameLine(void*) { ImGui::SameLine(); }
+void* Context(void*) { return ImGui::GetCurrentContext(); }
+
+// Any thread (game thread, a crash report): queued, drawn by the present thread.
+void Notify(void*, const char* mod_id, const char* msg) {
+    std::scoped_lock lock{toast_mutex};
+    if (toasts.size() >= 6) toasts.pop_front();
+    toasts.push_back({std::string(mod_id ? mod_id : "mods") + ": " + msg,
+                      std::chrono::steady_clock::now() + std::chrono::seconds(4)});
+    std::printf("Mods: %s: %s\n", mod_id ? mod_id : "host", msg);
+}
+
+// The in-game log window: the last lines runtime_modhost.c logged (the file has them all).
+struct LogLine {
+    int level;
+    std::string text;
+};
+std::mutex log_mutex;
+std::deque<LogLine> log_lines;
+bool log_follow = true;
+int log_min_level = 0;
+
+void LogWindow() {
+    ImGui::SetNextWindowSize(ImVec2(760.0f, 300.0f), ImGuiCond_FirstUseEver);
+    if (!ImGui::Begin("Mod log")) {
+        ImGui::End();
+        return;
+    }
+    ImGui::Text("Full log: %s", runtime_modhost_log_path());
+    static const char* levels = "debug\0info\0warn\0error\0";
+    ImGui::SetNextItemWidth(120.0f);
+    ImGui::Combo("show from", &log_min_level, levels);
+    ImGui::SameLine();
+    ImGui::Checkbox("follow", &log_follow);
+    ImGui::SameLine();
+    if (ImGui::SmallButton("Clear")) {
+        std::scoped_lock lock{log_mutex};
+        log_lines.clear();
+    }
+    ImGui::Separator();
+    ImGui::BeginChild("##log_lines");
+    {
+        std::scoped_lock lock{log_mutex};
+        for (const auto& l : log_lines) {
+            if (l.level < log_min_level) continue;
+            const ImVec4 colour = l.level >= 3 ? ImVec4(1.0f, 0.5f, 0.45f, 1.0f)
+                                : l.level == 2 ? ImVec4(0.95f, 0.8f, 0.4f, 1.0f)
+                                : l.level == 0 ? ImVec4(0.65f, 0.65f, 0.65f, 1.0f)
+                                               : ImVec4(0.9f, 0.9f, 0.9f, 1.0f);
+            ImGui::TextColored(colour, "%s", l.text.c_str());
+        }
+    }
+    if (log_follow && ImGui::GetScrollY() < ImGui::GetScrollMaxY()) ImGui::SetScrollHereY(1.0f);
+    ImGui::EndChild();
+    ImGui::End();
+}
+
+const char* StateName(modhost_state s) {
+    switch (s) {
+    case MODHOST_ACTIVE: return "active";
+    case MODHOST_UNLOADED: return "unloaded";
+    case MODHOST_FAULTED: return "faulted";
+    case MODHOST_DISABLED: return "disabled";
+    default: return "found";
+    }
+}
+ImVec4 StateColor(modhost_state s) {
+    switch (s) {
+    case MODHOST_ACTIVE: return ImVec4(0.45f, 0.85f, 0.45f, 1.0f);
+    case MODHOST_FAULTED: return ImVec4(1.0f, 0.45f, 0.4f, 1.0f);
+    case MODHOST_DISABLED: return ImVec4(0.9f, 0.75f, 0.35f, 1.0f);
+    default: return ImVec4(0.7f, 0.7f, 0.7f, 1.0f);
+    }
+}
+
+void ModsWindow(modhost* h) {
+    ImGui::SetNextWindowSize(ImVec2(560.0f, 0.0f), ImGuiCond_FirstUseEver);
+    if (!ImGui::Begin("Mods")) {
+        ImGui::End();
+        return;
+    }
+    const size_t n = modhost_mod_count(h);
+    if (n == 0) {
+        ImGui::TextUnformatted("No code mods. Put them in the bbmods folder (one folder per mod).");
+    }
+    ImGui::TextDisabled("F1 or Esc closes this overlay. Log: %s", runtime_modhost_log_path());
+    for (size_t i = 0; i < n; ++i) {
+        modhost_mod_view v;
+        if (modhost_mod_view_at(h, i, &v) != 0) continue;
+        ImGui::PushID(int(i));
+        ImGui::TextColored(StateColor(v.state), "%-9s", StateName(v.state));
+        ImGui::SameLine();
+        ImGui::Text("%s  %u.%u.%u", v.name, v.version.major, v.version.minor, v.version.patch);
+        if (v.has_code) {
+            ImGui::SameLine();
+            if (v.state == MODHOST_ACTIVE) {
+                if (ImGui::SmallButton("Reload")) modhost_request_reload(h, v.id);
+                ImGui::SameLine();
+                if (ImGui::SmallButton("Unload")) modhost_request_unload(h, v.id);
+            } else if (ImGui::SmallButton(v.state == MODHOST_FAULTED ? "Retry" : "Load")) {
+                modhost_request_reload(h, v.id);
+            }
+            if (v.state == MODHOST_ACTIVE) {
+                ImGui::SameLine();
+                ImGui::TextDisabled("%.2f ms  %u res  reloads %u", v.frame_ms, v.resources, v.reload_count);
+            }
+        }
+        if (v.last_error) ImGui::TextColored(ImVec4(1.0f, 0.55f, 0.5f, 1.0f), "  %s", v.last_error);
+        ImGui::PopID();
+    }
+    ImGui::End();
+}
+
+void Toasts() {
+    std::scoped_lock lock{toast_mutex};
+    const auto now = std::chrono::steady_clock::now();
+    while (!toasts.empty() && toasts.front().until <= now) toasts.pop_front();
+    if (toasts.empty()) return;
+    const ImGuiViewport* vp = ImGui::GetMainViewport();
+    ImGui::SetNextWindowPos(ImVec2(vp->WorkPos.x + vp->WorkSize.x - 20.0f, vp->WorkPos.y + vp->WorkSize.y - 20.0f),
+                            ImGuiCond_Always, ImVec2(1.0f, 1.0f));
+    ImGui::SetNextWindowBgAlpha(0.75f);
+    ImGui::Begin("##mod_toasts", nullptr,
+                 ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoInputs |
+                     ImGuiWindowFlags_NoFocusOnAppearing | ImGuiWindowFlags_NoNav);
+    for (const auto& t : toasts) ImGui::TextUnformatted(t.text.c_str());
+    ImGui::End();
+}
+
+} // namespace
+
+// runtime_modhost.c, any thread, under its log lock.
+extern "C" void bbport_modui_log(int level, const char* line) {
+    std::scoped_lock lock{log_mutex};
+    if (log_lines.size() >= 300) log_lines.pop_front();
+    log_lines.push_back({level, line});
+}
+
+extern "C" void bbport_modui_fill(modhost_ui_backend* ui) {
+    ui->user = nullptr;
+    ui->begin_panel = BeginPanel;
+    ui->end_panel = EndPanel;
+    ui->text = Text;
+    ui->button = Button;
+    ui->checkbox = Checkbox;
+    ui->slider_float = SliderFloat;
+    ui->separator = Separator;
+    ui->same_line = SameLine;
+    ui->notify = Notify;
+    ui->imgui_context = Context;
+    ui->slider_int = SliderInt;
+    ui->input_text = InputText;
+    ui->collapsing_header = CollapsingHeader;
+    ui->combo = Combo;
+    ui->text_colored = TextColored;
+}
+
+namespace BbModUi {
+
+bool Visible() {
+    std::scoped_lock lock{toast_mutex};
+    return !toasts.empty();
+}
+
+void Draw(bool menu_open) {
+    modhost* h = runtime_modhost_get();
+    if (!h) return;
+    if (menu_open && modhost_try_lock(h)) {
+        ModsWindow(h);
+        modhost_draw_panels(h);
+        modhost_unlock(h);
+    }
+    if (menu_open) LogWindow();
+    Toasts();
+}
+
+} // namespace BbModUi
