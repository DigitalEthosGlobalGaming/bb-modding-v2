+void Draw(bool menu_open);
+#else
+inline bool Captures() { return false; }
+inline bool LayersActive() { return false; }
+inline void Input(unsigned) {}
+inline void SetFrameSize(unsigned, unsigned) {}
+inline bool Visible() { return false; }
+inline bool TryBeginFrame(bool) { return true; }
+inline void EndFrame(bool) {}
+inline void Draw(bool) {}
+#endif
+} // namespace BbModUi
