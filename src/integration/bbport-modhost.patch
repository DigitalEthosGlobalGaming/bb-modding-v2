+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Native code mods (runtime_modhost.c). No-ops unless built with BB_MODHOST. */
+#ifndef BB_RUNTIME_MODHOST_H
+#define BB_RUNTIME_MODHOST_H
+#include <stddef.h>
+#include <stdint.h>
+/* probe.c: after the eboot is mapped, relocated, patched and protected. */
+void runtime_modhost_start(unsigned char *image, uint64_t size);
+/* runtime_pad.c: the buttons the game just read, then the per-frame sync point. */
+void runtime_modhost_pad(uint32_t buttons);
+void runtime_modhost_frame(void);
+/* probe.c's fault handler: the mod whose code faulted (or NULL), and marking it. */
+const char *runtime_modhost_fault_owner(uintptr_t rip);
+void runtime_modhost_fault(uintptr_t rip);
+/* runtime_file.c: 1 and a host path in out when a mod overrides this guest path. */
+int runtime_modhost_resolve(const char *guest, char *out, size_t size);
+/* The mods log file (empty without a mod host). */
+const char *runtime_modhost_log_path(void);
+#endif
