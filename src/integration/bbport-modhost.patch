+#include "../src/runtime_text_input.c"
+#include <assert.h>
+static int window_available=1,window_state,window_cancel,cancel_count;
+static char window_text[4096];
+int bbgpu_text_input_begin_limited(const char*initial,const char*title,uint32_t max){
+    (void)max;assert(title);if(!window_available)return 0;
+    snprintf(window_text,sizeof window_text,"%s",initial);window_state=0;window_cancel=0;return 1;
+}
+int bbgpu_text_input_poll(char*out,uint64_t size){if(out&&size)snprintf(out,(size_t)size,"%s",window_text);return window_cancel?0:window_state;}
+void bbgpu_text_input_cancel(void){window_cancel=1;window_state=0;cancel_count++;}
+static void ack_cancel(void){assert(window_cancel);window_cancel=0;window_state=2;}
+int main(void){
+#ifdef _WIN32
+    _putenv("BB_IME_TEXT=");
+#else
+    unsetenv("BB_IME_TEXT");
+#endif
+    uint16_t buffer[32]={'O','l','d',0},title[]={'G','a','m','e',0};
+    ImeParam p={0};p.buffer=buffer;p.max_length=31;p.title=title;
+    uint64_t mod=0;uint32_t result=99;
+    assert(!ime_init(&p,NULL)&&ime_status()==1&&!strcmp(window_text,"Old"));
+    assert(runtime_text_begin("Setting","Mod",127,&mod)==-3);
+    strcpy(window_text,"Unicode \xe2\x9c\x93");window_state=1;
+    assert(ime_status()==2&&!ime_result(&result)&&result==0&&buffer[8]==0x2713);
+    assert(!runtime_text_begin("Setting","Mod",127,&mod));
+    assert(!ime_term()&&cancel_count==0); /* the old game's token cannot close Mod */
+    assert((uint32_t)ime_init(&p,NULL)==0x80BC0003&&!ime.running);
+    runtime_text_cancel(mod);assert(cancel_count==1);
+    assert((uint32_t)ime_init(&p,NULL)==0x80BC0003);ack_cancel();
+    assert(!ime_init(&p,NULL));assert(!ime_term()&&cancel_count==2);
+    assert(runtime_text_begin("Setting","Mod",127,&mod)==-3);ack_cancel();
+    assert(!runtime_text_begin("Setting","Mod",127,&mod));window_state=2;
+    assert(runtime_text_poll(mod,NULL,0)==2);
+    assert(!ime_init(&p,NULL));window_state=2;
+    assert(ime_status()==2&&!ime_result(&result)&&result==1&&buffer[8]==0x2713);
+    assert(!ime_term());window_available=0;
+    assert(!ime_init(&p,NULL)&&ime_status()==2&&!ime_result(&result)&&result==0);
+    assert(!ime_term());
+    puts("actual game IME: UTF-16 result, cancellation, no-window fallback and exclusion with mod dialogs: OK");return 0;
+}
