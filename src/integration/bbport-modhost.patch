diff --git a/src/runtime_modhost.c b/src/runtime_modhost.c
new file mode 100644
index 0000000..7859d6e
--- /dev/null
+++ b/src/runtime_modhost.c
@@ -0,0 +1,228 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Native code mods (bbmod, third_party/bbmod): the glue between bbport and the
+ * mod host. Built with -DBB_MODHOST (gpu/CMakeLists.txt, on when
+ * third_party/bbmod is present); without it every function here is a no-op.
+ *
+ *   BB_CODEMODS_DIR   mod folder (run.py: <data>/bbmods; default ./bbmods)
+ *   BB_MODS_DEV=1     watch mod DLLs and hot reload them when they change
+ *   BB_MODS_SAFE=1    discover mods but load none (a mod crashes at start)
+ *   BB_MODHOST=0      no mod host at all
+ *   BB_MODS_LOG       log file (default: <mods folder>.log, e.g. bbmods.log; the previous
+ *                     run's is kept as bbmods.prev.log). Every host and mod line, debug
+ *                     included, timestamped and flushed per line.
+ *
+ * Sync point: the game's pad poll (scePadReadState), on the first thread that
+ * polls. Mod frame callbacks, reloads and network events run there, once per
+ * poll, outside the pad lock. */
+#include "runtime.h"
+#include "runtime_modhost.h"
+
+#ifdef BB_MODHOST
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <pthread.h>
+#include <SDL3/SDL.h>
+#include "gpu/bbgpu.h"
+#include "modhost.h"
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+static uint64_t thread_id(void) { return GetCurrentThreadId(); }
+#else
+#include <pthread.h>
+static uint64_t thread_id(void) { return (uint64_t)(uintptr_t)pthread_self(); }
+#endif
+
+void bbport_modui_fill(modhost_ui_backend *ui);     /* gpu/shim/bbport_modui.cpp */
+void bbport_modui_log(int level, const char *line); /* its in-game log window */
+
+static modhost *host;
+static uint64_t sync_thread;
+static volatile uint32_t pad_buttons;
+static int dev_mode;
+
+static FILE *log_file;
+static char log_path[1100];
+static pthread_mutex_t log_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static void open_log(const char *dir) {
+    const char *p = getenv("BB_MODS_LOG");
+    if (p && *p) snprintf(log_path, sizeof(log_path), "%s", p);
+    else snprintf(log_path, sizeof(log_path), "%s.log", dir);
+    char prev[1200];
+    snprintf(prev, sizeof(prev), "%.*s.prev.log", (int)(strlen(log_path) > 4 ? strlen(log_path) - 4 : strlen(log_path)), log_path);
+    remove(prev);
+    rename(log_path, prev);
+    log_file = fopen(log_path, "w");
+    if (log_file) {
+        time_t now = time(NULL);
+        char when[64];
+        strftime(when, sizeof(when), "%Y-%m-%d %H:%M:%S", localtime(&now));
+        fprintf(log_file, "bbport code mods log, started %s\n", when);
+        fflush(log_file);
+    }
+}
+
+/* Any thread (game, overlay, mod workers): one lock for the file, console and window. */
+static void log_line(void *user, const char *mod_id, int level, const char *msg) {
+    (void)user;
+    static const char *names[] = {"debug", "info", "warn", "error"};
+    int hh, mm, ss, ms;
+#ifdef _WIN32
+    SYSTEMTIME st;
+    GetLocalTime(&st);
+    hh = st.wHour; mm = st.wMinute; ss = st.wSecond; ms = st.wMilliseconds;
+#else
+    struct timespec ts;
+    clock_gettime(CLOCK_REALTIME, &ts);
+    time_t secs = ts.tv_sec;
+    struct tm tm_now = *localtime(&secs);
+    hh = tm_now.tm_hour; mm = tm_now.tm_min; ss = tm_now.tm_sec; ms = (int)(ts.tv_nsec / 1000000);
+#endif
+    char line[1400];
+    snprintf(line, sizeof(line), "%02d:%02d:%02d.%03d [%s] %s%s%s", hh, mm, ss, ms, names[level & 3],
+             mod_id ? mod_id : "host", mod_id ? ": " : "", msg);
+    pthread_mutex_lock(&log_lock);
+    if (log_file) {
+        fputs(line, log_file);
+        fputc('\n', log_file);
+        fflush(log_file); /* survives a crash */
+    }
+    if (level >= BBM_LOG_INFO || dev_mode) {
+        printf("Mods: %s\n", line + 13);
+        fflush(stdout);
+    }
+    bbport_modui_log(level, line);
+    pthread_mutex_unlock(&log_lock);
+}
+
+const char *runtime_modhost_log_path(void) { return log_path; }
+
+/* A crash inside mod code during a host call jumps back here (probe.c's fault
+ * handler resumes the thread through runtime_fault_recover), and only that mod
+ * is disabled. */
+static int call_guarded(void *user, void (*fn)(void *), void *arg) {
+    (void)user;
+    sigjmp_buf buffer;
+    sigjmp_buf *volatile previous = runtime_fault_recover;
+    if (sigsetjmp(buffer, 1)) {
+        runtime_fault_recover = previous;
+        return 1;
+    }
+    runtime_fault_recover = &buffer;
+    fn(arg);
+    runtime_fault_recover = previous;
+    return 0;
+}
+
+static const uint8_t *keyboard(void *user, int *count) {
+    (void)user;
+    if (bbgpu_overlay_captures_input() || !SDL_WasInit(SDL_INIT_VIDEO)) return NULL;
+    return (const uint8_t *)SDL_GetKeyboardState(count); /* bool[], one byte each */
+}
+
+static uint32_t pad(void *user) {
+    (void)user;
+    return __atomic_load_n(&pad_buttons, __ATOMIC_RELAXED);
+}
+
+static int env_on(const char *name) {
+    const char *v = getenv(name);
+    return v && v[0] == '1';
+}
+
+void runtime_modhost_start(unsigned char *image, uint64_t size) {
+    const char *off = getenv("BB_MODHOST");
+    if (off && off[0] == '0') { puts("Mods: disabled (BB_MODHOST=0)"); return; }
+    static char dir[1024], cache[1100];
+    const char *d = getenv("BB_CODEMODS_DIR");
+    snprintf(dir, sizeof(dir), "%s", d && *d ? d : "bbmods");
+    snprintf(cache, sizeof(cache), "%s-cache", dir); /* beside, so it is not scanned as a mod */
+    dev_mode = env_on("BB_MODS_DEV");
+    open_log(dir);
+
+    modhost_config c;
+    memset(&c, 0, sizeof(c));
+    c.mods_dir = dir;
+    c.cache_dir = cache;
+    c.eboot_base = (uintptr_t)image;
+    c.eboot_size = (size_t)size;
+    c.ps4_eboot_base = 0x400000;
+    c.dev_mode = dev_mode;
+    c.safe_mode = env_on("BB_MODS_SAFE");
+    c.log = log_line;
+    c.platform.call_guarded = call_guarded;
+    c.input.keyboard = keyboard;
+    c.input.pad_buttons = pad;
+    bbport_modui_fill(&c.ui);
+    host = modhost_create(&c);
+    if (!host) { puts("Mods: could not start the mod host"); return; }
+    int n = modhost_scan(host);
+    printf("Mods: %d in %s%s%s; log: %s; F1 opens the mods overlay\n", n, dir, dev_mode ? " (hot reload on)" : "",
+           c.safe_mode ? " (safe mode: none loaded)" : "", log_path);
+}
+
+void runtime_modhost_pad(uint32_t buttons) { __atomic_store_n(&pad_buttons, buttons, __ATOMIC_RELAXED); }
+
+void runtime_modhost_frame(void) {
+    if (!host) return;
+    uint64_t self = thread_id();
+    if (!sync_thread) sync_thread = self;
+    if (self != sync_thread) return;
+    modhost_frame(host);
+    if (dev_mode) {
+        /* BB_MODS_DEV: report the sync point's rate once, to confirm it runs per frame. */
+        static time_t start;
+        static unsigned calls;
+        static int reported;
+        if (!start) start = time(NULL);
+        ++calls;
+        if (!reported && time(NULL) - start >= 10) {
+            printf("Mods: sync point ran %.1f times/s over 10 s (thread %llu)\n", calls / 10.0,
+                   (unsigned long long)sync_thread);
+            reported = 1;
+        }
+    }
+}
+
+const char *runtime_modhost_fault_owner(uintptr_t rip) { return host ? modhost_fault_owner(host, rip) : NULL; }
+
+void runtime_modhost_fault(uintptr_t rip) {
+    if (host) modhost_on_fault(host, rip);
+}
+
+int runtime_modhost_resolve(const char *guest, char *out, size_t size) {
+    if (!host) return 0;
+    const char *at = strstr(guest, "dvdroot_ps4/");
+    if (!at) return 0;
+    char path[1024];
+    if (!modhost_vfs_resolve(host, at, path, sizeof(path))) return 0;
+    size_t n = strlen(path);
+    if (n + 1 > size) return 0;
+    memcpy(out, path, n + 1);
+    return 1;
+}
+
+modhost *runtime_modhost_get(void) { return host; }
+
+#else /* !BB_MODHOST */
+
+void runtime_modhost_start(unsigned char *image, uint64_t size) { (void)image; (void)size; }
+void runtime_modhost_pad(uint32_t buttons) { (void)buttons; }
+void runtime_modhost_frame(void) {}
+const char *runtime_modhost_fault_owner(uintptr_t rip) { (void)rip; return NULL; }
+void runtime_modhost_fault(uintptr_t rip) { (void)rip; }
+int runtime_modhost_resolve(const char *guest, char *out, size_t size) {
+    (void)guest; (void)out; (void)size;
+    return 0;
+}
+void *runtime_modhost_get(void); /* referenced by gpu/shim/bbport_modui.cpp when that is built */
+void *runtime_modhost_get(void) { return NULL; }
+const char *runtime_modhost_log_path(void);
+const char *runtime_modhost_log_path(void) { return ""; }
+
+#endif
