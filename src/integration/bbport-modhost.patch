+const char *runtime_modhost_fault_owner(uintptr_t rip) { return host ? modhost_fault_owner(host, rip) : NULL; }
+
+void runtime_modhost_fault(uintptr_t rip) {
+    if (host) modhost_on_fault(host, rip);
+}
+
+int runtime_modhost_resolve(const char *guest, char *out, size_t size) {
+    if (!host) return 0;
+    const char *at = strstr(guest, "dvdroot_ps4/");
+    if (!at) return 0;
+    char path[1024];
+    if (!modhost_vfs_resolve(host, at, path, sizeof(path))) return 0;
+    size_t n = strlen(path);
+    if (n + 1 > size) return 0;
+    memcpy(out, path, n + 1);
+    return 1;
+}
+
+modhost *runtime_modhost_get(void) { return host; }
