diff --git a/src/runtime_text_input.c b/src/runtime_text_input.c
new file mode 100644
index 0000000..57a65fe
--- /dev/null
+++ b/src/runtime_text_input.c
@@ -0,0 +1,30 @@
+#include "runtime_text_input.h"
+#include "gpu/bbgpu.h"
+#include <pthread.h>
+static pthread_mutex_t text_lock=PTHREAD_MUTEX_INITIALIZER;
+static uint64_t sequence,active;
+static int cancelling;
+int runtime_text_begin(const char *initial,const char *title,uint32_t max_bytes,uint64_t *token){
+    if(!token)return -2;*token=0;pthread_mutex_lock(&text_lock);
+    /* A cancellation is a window-thread request. Do not let a late request
+     * cancel the next dialog; wait for the same window to acknowledge it. */
+    if(cancelling&&bbgpu_text_input_poll(NULL,0)!=0){active=0;cancelling=0;}
+    int rc=0;
+    if(active)rc=-3;
+    else if(!bbgpu_text_input_begin_limited(initial,title,max_bytes))rc=-4;
+    else {if(!++sequence)++sequence;active=sequence;*token=active;}
+    pthread_mutex_unlock(&text_lock);return rc;
+}
+int runtime_text_poll(uint64_t token,char *out,size_t size){
+    pthread_mutex_lock(&text_lock);int state=-7;
+    if(token&&token==active){
+        state=bbgpu_text_input_poll(out,size);
+        if(state){active=0;cancelling=0;}
+    }
+    pthread_mutex_unlock(&text_lock);return state;
+}
+void runtime_text_cancel(uint64_t token){
+    pthread_mutex_lock(&text_lock);
+    if(token&&token==active&&!cancelling){bbgpu_text_input_cancel();cancelling=1;}
+    pthread_mutex_unlock(&text_lock);
+}
