@@ -0,0 +1,455 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: native code mods in the overlay (bbmod, src/runtime_modhost.c). While the settings
+// menu is open: a "Mods" window (state, errors, load/unload/reload) and every panel the mods
+// register. Mod notifications show as toasts at any time. Drawn on the present thread inside
+// BbOverlay::Render (imgui_mutex held); the mod host is only try-locked here, so a hot reload
+// running on the game thread reuses the previous overlay frame, never a stall.
+
+#include "bbport_modui.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <deque>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include "imgui.h"
+#include "modhost.h"
+
+extern "C" modhost* runtime_modhost_get(void);
+extern "C" const char* runtime_modhost_log_path(void);
+
+namespace {
+
+struct Toast {
+    std::string text;
+    std::chrono::steady_clock::time_point until;
+};
+std::mutex toast_mutex;
+std::deque<Toast> toasts;
+
+int BeginPanel(void*, const char* title, const char* mod_id) {
+    char id[320];
+    std::snprintf(id, sizeof(id), "%s##%s", title, mod_id);
+    ImGui::SetNextWindowSize(ImVec2(420.0f, 0.0f), ImGuiCond_FirstUseEver);
+    return ImGui::Begin(id) ? 1 : 0;
+}
+void EndPanel(void*) { ImGui::End(); }
+void Text(void*, const char* text) { ImGui::TextUnformatted(text); }
+int Button(void*, const char* label) { return ImGui::Button(label) ? 1 : 0; }
+int Checkbox(void*, const char* label, int32_t* value) {
+    bool v = *value != 0;
+    const bool changed = ImGui::Checkbox(label, &v);
+    *value = v ? 1 : 0;
+    return changed ? 1 : 0;
+}
+int SliderFloat(void*, const char* label, float* v, float lo, float hi) {
+    return ImGui::SliderFloat(label, v, lo, hi) ? 1 : 0;
+}
+int SliderInt(void*, const char* label, int32_t* v, int32_t lo, int32_t hi) {
+    int x = *v;
+    const bool changed = ImGui::SliderInt(label, &x, lo, hi);
+    *v = x;
+    return changed ? 1 : 0;
+}
+int InputText(void*, const char* label, char* buf, size_t cap) {
+    return ImGui::InputText(label, buf, cap) ? 1 : 0;
+}
+int CollapsingHeader(void*, const char* label) { return ImGui::CollapsingHeader(label) ? 1 : 0; }
+int Combo(void*, const char* label, int32_t* current, const char* items) {
+    int c = *current;
+    const bool changed = ImGui::Combo(label, &c, items);
+    *current = c;
+    return changed ? 1 : 0;
+}
+void TextColored(void*, float r, float g, float b, float a, const char* text) {
+    ImGui::TextColored(ImVec4(r, g, b, a), "%s", text);
+}
+void Separator(void*) { ImGui::Separator(); }
+void SameLine(void*) { ImGui::SameLine(); }
+void PushScope(void*, const char* owner, const char* key) {
+    ImGui::PushID(owner);
+    ImGui::PushID(key);
+}
+void PopScope(void*) { ImGui::PopID(); ImGui::PopID(); }
+void* Context(void*) { return ImGui::GetCurrentContext(); }
+
+int TableBegin(void*,const char* id,const char*const* headers,uint32_t count,float height,int32_t* sort,int32_t* descending) {
+    const ImGuiTableFlags flags=ImGuiTableFlags_Borders | ImGuiTableFlags_RowBg |
+        ImGuiTableFlags_Resizable | ImGuiTableFlags_Sortable | ImGuiTableFlags_ScrollX |
+        ImGuiTableFlags_ScrollY | ImGuiTableFlags_SizingFixedFit;
+    if(!ImGui::BeginTable(id,static_cast<int>(count),flags,ImVec2(0,height),count*110.0f)) return 0;
+    for(uint32_t i=0;i<count;i++) {
+        ImGuiTableColumnFlags column=ImGuiTableColumnFlags_None;
+        if(static_cast<int32_t>(i)==*sort) column|=ImGuiTableColumnFlags_DefaultSort;
+        if(*descending) column|=ImGuiTableColumnFlags_PreferSortDescending;
+        ImGui::TableSetupColumn(headers[i],column,i==0?180.0f:100.0f);
+    }
+    ImGui::TableSetupScrollFreeze(1,1);
+    ImGui::TableHeadersRow();
+    if(auto* specs=ImGui::TableGetSortSpecs();specs && specs->SpecsCount>0) {
+        *sort=specs->Specs[0].ColumnIndex;
+        *descending=specs->Specs[0].SortDirection==ImGuiSortDirection_Descending;
+        specs->SpecsDirty=false;
+    }
+    return 1;
+}
+void TableRow(void*) { ImGui::TableNextRow(); }
+void TableColumn(void*) { ImGui::TableNextColumn(); }
+void TableEnd(void*) { ImGui::EndTable(); }
+
+// Any thread (game thread, a crash report): queued, drawn by the present thread.
+void Notify(void*, const char* mod_id, const char* msg) {
+    std::scoped_lock lock{toast_mutex};
+    if (toasts.size() >= 6) toasts.pop_front();
+    toasts.push_back({std::string(mod_id ? mod_id : "mods") + ": " + msg,
+                      std::chrono::steady_clock::now() + std::chrono::seconds(4)});
+    std::printf("Mods: %s: %s\n", mod_id ? mod_id : "host", msg);
+}
+
+// The in-game log window: the last lines runtime_modhost.c logged (the file has them all).
+struct LogLine {
+    int level;
+    std::string text;
+};
+std::mutex log_mutex;
+std::deque<LogLine> log_lines;
+bool log_follow = true;
+int log_min_level = 0;
+
+void LogWindow() {
+    ImGui::SetNextWindowSize(ImVec2(760.0f, 300.0f), ImGuiCond_FirstUseEver);
+    if (!ImGui::Begin("Mod log")) {
+        ImGui::End();
+        return;
+    }
+    ImGui::Text("Full log: %s", runtime_modhost_log_path());
+    static const char* levels = "debug\0info\0warn\0error\0";
+    ImGui::SetNextItemWidth(120.0f);
+    ImGui::Combo("show from", &log_min_level, levels);
+    ImGui::SameLine();
+    ImGui::Checkbox("follow", &log_follow);
+    ImGui::SameLine();
+    if (ImGui::SmallButton("Clear")) {
+        std::scoped_lock lock{log_mutex};
+        log_lines.clear();
+    }
+    ImGui::Separator();
+    ImGui::BeginChild("##log_lines");
+    {
+        std::scoped_lock lock{log_mutex};
+        for (const auto& l : log_lines) {
+            if (l.level < log_min_level) continue;
+            const ImVec4 colour = l.level >= 3 ? ImVec4(1.0f, 0.5f, 0.45f, 1.0f)
+                                : l.level == 2 ? ImVec4(0.95f, 0.8f, 0.4f, 1.0f)
+                                : l.level == 0 ? ImVec4(0.65f, 0.65f, 0.65f, 1.0f)
+                                               : ImVec4(0.9f, 0.9f, 0.9f, 1.0f);
+            ImGui::TextColored(colour, "%s", l.text.c_str());
+        }
+    }
+    if (log_follow && ImGui::GetScrollY() < ImGui::GetScrollMaxY()) ImGui::SetScrollHereY(1.0f);
+    ImGui::EndChild();
+    ImGui::End();
+}
+
+const char* StateName(modhost_state s) {
+    switch (s) {
+    case MODHOST_ACTIVE: return "active";
+    case MODHOST_UNLOADED: return "unloaded";
+    case MODHOST_FAULTED: return "faulted";
+    case MODHOST_DISABLED: return "disabled";
+    default: return "found";
+    }
+}
+ImVec4 StateColor(modhost_state s) {
+    switch (s) {
+    case MODHOST_ACTIVE: return ImVec4(0.45f, 0.85f, 0.45f, 1.0f);
+    case MODHOST_FAULTED: return ImVec4(1.0f, 0.45f, 0.4f, 1.0f);
+    case MODHOST_DISABLED: return ImVec4(0.9f, 0.75f, 0.35f, 1.0f);
+    default: return ImVec4(0.7f, 0.7f, 0.7f, 1.0f);
+    }
+}
+
+void ModsWindow(modhost* h) {
+    ImGui::SetNextWindowSize(ImVec2(560.0f, 0.0f), ImGuiCond_FirstUseEver);
+    if (!ImGui::Begin("Mods")) {
+        ImGui::End();
+        return;
+    }
+    const size_t n = modhost_mod_count(h);
+    if (n == 0) {
+        ImGui::TextUnformatted("No code mods. Put them in the bbmods folder (one folder per mod).");
+    }
+    ImGui::TextDisabled("F1 or Esc closes this overlay. Log: %s", runtime_modhost_log_path());
+    for (size_t i = 0; i < n; ++i) {
+        modhost_mod_view v;
+        if (modhost_mod_view_at(h, i, &v) != 0) continue;
+        ImGui::PushID(int(i));
+        ImGui::TextColored(StateColor(v.state), "%-9s", StateName(v.state));
+        ImGui::SameLine();
+        ImGui::Text("%s  %u.%u.%u", v.name, v.version.major, v.version.minor, v.version.patch);
+        if (v.has_code) {
+            ImGui::SameLine();
+            if (v.state == MODHOST_ACTIVE) {
+                if (ImGui::SmallButton("Reload")) modhost_request_reload(h, v.id);
+                ImGui::SameLine();
+                if (ImGui::SmallButton("Unload")) modhost_request_unload(h, v.id);
+            } else if (ImGui::SmallButton(v.state == MODHOST_FAULTED ? "Retry" : "Load")) {
+                modhost_request_reload(h, v.id);
+            }
+            if (v.state == MODHOST_ACTIVE) {
+                ImGui::SameLine();
+                ImGui::TextDisabled("%.2f ms  %u res  reloads %u", v.frame_ms, v.resources, v.reload_count);
+            }
+        }
+        if (v.last_error) ImGui::TextColored(ImVec4(1.0f, 0.55f, 0.5f, 1.0f), "  %s", v.last_error);
+        ImGui::PopID();
+    }
+    ImGui::End();
+}
+
+void Toasts() {
+    std::scoped_lock lock{toast_mutex};
+    const auto now = std::chrono::steady_clock::now();
+    while (!toasts.empty() && toasts.front().until <= now) toasts.pop_front();
+    if (toasts.empty()) return;
+    const ImGuiViewport* vp = ImGui::GetMainViewport();
+    ImGui::SetNextWindowPos(ImVec2(vp->WorkPos.x + vp->WorkSize.x - 20.0f, vp->WorkPos.y + vp->WorkSize.y - 20.0f),
+                            ImGuiCond_Always, ImVec2(1.0f, 1.0f));
+    ImGui::SetNextWindowBgAlpha(0.75f);
+    ImGui::Begin("##mod_toasts", nullptr,
+                 ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoInputs |
+                     ImGuiWindowFlags_NoFocusOnAppearing | ImGuiWindowFlags_NoNav);
+    for (const auto& t : toasts) ImGui::TextUnformatted(t.text.c_str());
+    ImGui::End();
+}
+
+// ---- Retained mod layers (ABI 1.11) --------------------------------------------------------
+// The host owns the fade, arbitration and input capture. Here we copy each frame's views under
+// a try-lock (so a reload on the game thread reuses the previous frame instead of blinking) and
+// draw the validated 'BBUI' streams with the ImGui draw list, mapped from the 1920x1080 stage
+// into the same aspect-fit rectangle the presenter uses for the game frame.
+
+struct CachedLayer {
+    unsigned kind = 0;
+    float alpha = 1.0f;
+    std::vector<uint8_t> cmds;
+};
+std::vector<CachedLayer> layer_cache; // present thread only
+std::atomic<unsigned> frame_w{1920}, frame_h{1080};
+
+void RefreshLayers(modhost* h) {
+    if (!modhost_ui_active(h)) {
+        layer_cache.clear();
+        return;
+    }
+    if (!modhost_try_lock(h)) return; // game thread is reloading: keep the last good frame
+    modhost_ui_layer_view views[64];
+    const size_t n = modhost_ui_layers(h, views, 64);
+    layer_cache.resize(n);
+    for (size_t i = 0; i < n; ++i) {
+        layer_cache[i].kind = views[i].kind;
+        layer_cache[i].alpha = views[i].alpha;
+        layer_cache[i].cmds.assign(views[i].cmds, views[i].cmds + views[i].n);
+    }
+    modhost_unlock(h);
+}
+
+struct Reader {
+    const uint8_t* p;
+    size_t n, at = 12;
+    bool ok = true;
+    float f32() {
+        float v = 0;
+        if (at + 4 > n) { ok = false; return 0; }
+        std::memcpy(&v, p + at, 4);
+        at += 4;
+        return v;
+    }
+    uint32_t u32() {
+        uint32_t v = 0;
+        if (at + 4 > n) { ok = false; return 0; }
+        std::memcpy(&v, p + at, 4);
+        at += 4;
+        return v;
+    }
+    uint8_t u8() {
+        if (at + 1 > n) { ok = false; return 0; }
+        return p[at++];
+    }
+    const char* bytes(size_t len) {
+        if (at + len > n) { ok = false; return nullptr; }
+        const char* s = reinterpret_cast<const char*>(p + at);
+        at += len;
+        return s;
+    }
+};
+
+ImU32 Rgba(uint32_t c, float alpha) {
+    const unsigned a = static_cast<unsigned>(float(c & 0xff) * std::clamp(alpha, 0.0f, 1.0f) + 0.5f);
+    return IM_COL32((c >> 24) & 0xff, (c >> 16) & 0xff, (c >> 8) & 0xff, a);
+}
+
+// Game button art is not decoded yet: draw the prompt as a labelled badge.
+const char* PromptLabel(const std::string& name) {
+    if (name == "KG_OK") return "X";
+    if (name == "KG_Cancel") return "O";
+    if (name == "KG_L1") return "L1";
+    if (name == "KG_R1") return "R1";
+    return name.rfind("KG_", 0) == 0 ? name.c_str() + 3 : name.c_str();
+}
+
+void DrawStream(ImDrawList* dl, const CachedLayer& layer, float ox, float oy, float s) {
+    const std::vector<uint8_t>& b = layer.cmds;
+    if (b.size() < 12 || std::memcmp(b.data(), "BBUI", 4) != 0) return;
+    uint32_t count = 0;
+    std::memcpy(&count, b.data() + 8, 4);
+    Reader r{b.data(), b.size()};
+    ImFont* font = ImGui::GetFont();
+    for (uint32_t i = 0; i < count && r.ok; ++i) {
+        const uint8_t op = r.u8();
+        const float x = r.f32() * s + ox, y = r.f32() * s + oy, w = r.f32() * s, h = r.f32() * s;
+        const ImVec2 lo(x, y), hi(x + w, y + h);
+        if (op == 1) {
+            dl->AddRectFilled(lo, hi, Rgba(r.u32(), layer.alpha));
+        } else if (op == 2) {
+            const float width = r.f32() * s;
+            dl->AddRect(lo, hi, Rgba(r.u32(), layer.alpha), 0.0f, 0, std::max(1.0f, width));
+        } else if (op == 3) {
+            const float size = r.f32() * s;
+            const uint32_t color = r.u32();
+            const uint8_t align = r.u8(), bold = r.u8();
+            const uint16_t len = static_cast<uint16_t>(r.u8() | (r.u8() << 8));
+            const char* text = r.bytes(len);
+            if (!r.ok || !text || len == 0) continue;
+            const ImVec2 ts = font->CalcTextSizeA(size, FLT_MAX, 0.0f, text, text + len);
+            float tx = x;
+            if (ts.x < w) tx += align == 1 ? (w - ts.x) * 0.5f : align == 2 ? (w - ts.x) : 0.0f;
+            const float ty = y + (h - ts.y) * 0.5f;
+            dl->PushClipRect(lo, hi, true);
+            const ImU32 col = Rgba(color, layer.alpha);
+            dl->AddText(font, size, ImVec2(tx, ty), col, text, text + len);
+            if (bold) dl->AddText(font, size, ImVec2(tx + std::max(0.6f, size * 0.03f), ty), col, text, text + len);
+            dl->PopClipRect();
+        } else if (op == 4) {
+            const uint32_t tint = r.u32();
+            const uint8_t len = r.u8();
+            const char* name = r.bytes(len);
+            if (!r.ok || !name) continue;
+            const std::string label = PromptLabel(std::string(name, len));
+            const float side = std::min(w, h);
+            const ImVec2 c(x + w * 0.5f, y + h * 0.5f);
+            dl->AddCircleFilled(c, side * 0.5f, Rgba(0x00000099, layer.alpha), 24);
+            dl->AddCircle(c, side * 0.5f, Rgba(tint, layer.alpha), 24, std::max(1.0f, s * 1.5f));
+            const float size = side * (label.size() > 1 ? 0.42f : 0.55f);
+            const ImVec2 ts = font->CalcTextSizeA(size, FLT_MAX, 0.0f, label.c_str());
+            dl->AddText(font, size, ImVec2(c.x - ts.x * 0.5f, c.y - ts.y * 0.5f), Rgba(tint, layer.alpha), label.c_str());
+        } else {
+            return;
+        }
+    }
+}
+
+void DrawLayers() {
+    if (layer_cache.empty()) return;
+    const ImVec2 out = ImGui::GetIO().DisplaySize;
+    const float fw = float(frame_w.load()), fh = float(frame_h.load());
+    if (out.x <= 0 || out.y <= 0 || fw <= 0 || fh <= 0) return;
+    const float fit = std::min(out.x / fw, out.y / fh); // the presenter's aspect fit of the game frame
+    const float rw = fw * fit, rh = fh * fit;
+    const float scale = std::min(rw / 1920.0f, rh / 1080.0f); // the stage inside that rectangle
+    const float ox = (out.x - rw) * 0.5f + (rw - 1920.0f * scale) * 0.5f;
+    const float oy = (out.y - rh) * 0.5f + (rh - 1080.0f * scale) * 0.5f;
+    ImDrawList* dl = ImGui::GetBackgroundDrawList(); // under the developer windows
+    for (const CachedLayer& layer : layer_cache) DrawStream(dl, layer, ox, oy, scale);
+}
