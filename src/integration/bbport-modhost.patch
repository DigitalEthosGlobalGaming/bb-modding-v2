+void runtime_modhost_start(unsigned char *image, uint64_t size) {
+    const char *off = getenv("BB_MODHOST");
+    if (off && off[0] == '0') { puts("Mods: disabled (BB_MODHOST=0)"); return; }
+    static char dir[1024], cache[1100];
+    const char *d = getenv("BB_CODEMODS_DIR");
+    snprintf(dir, sizeof(dir), "%s", d && *d ? d : "bbmods");
+    snprintf(cache, sizeof(cache), "%s-cache", dir); /* beside, so it is not scanned as a mod */
+    dev_mode = env_on("BB_MODS_DEV");
+    open_log(dir);
+
+    modhost_config c;
+    memset(&c, 0, sizeof(c));
+    c.mods_dir = dir;
+    c.cache_dir = cache;
+    c.eboot_base = (uintptr_t)image;
+    c.eboot_size = (size_t)size;
+    c.ps4_eboot_base = 0x400000;
+    c.dev_mode = dev_mode;
+    c.safe_mode = env_on("BB_MODS_SAFE");
+    c.native_observation = env_on("BB_MODS_NATIVE_OBSERVATION");
+    c.log = log_line;
+    c.platform.call_guarded = call_guarded;
+    c.input.keyboard = keyboard;
+    c.input.pad_buttons = pad;
+    c.text=(modhost_text_backend){NULL,mod_text_begin,mod_text_poll,mod_text_cancel};
+    c.pad.haptics = runtime_pad_haptics;
+    c.pad.info = runtime_pad_effect_info;
+    c.pad.send_triggers = runtime_pad_effect_send;
+    c.pad.lightbar = runtime_pad_effect_led;
+    c.pad.captured = pad_captured;
+    atexit(reset_pad_at_exit);
+    bbport_modui_fill(&c.ui);
+    host = modhost_create(&c);
+    if (!host) { puts("Mods: could not start the mod host"); return; }
+    int n = modhost_scan(host);
+    printf("Mods: %d in %s%s%s; log: %s; F1 opens the mods overlay\n", n, dir, dev_mode ? " (hot reload on)" : "",
+           c.safe_mode ? " (safe mode: none loaded)" : "", log_path);
+}
+
+void runtime_modhost_pad(uint32_t buttons) { __atomic_store_n(&pad_buttons, buttons, __ATOMIC_RELAXED); }
+
+void runtime_modhost_frame(void) {
+    if (!host) return;
+    uint64_t self = thread_id();
+    if (!sync_thread) sync_thread = self;
+    if (self != sync_thread) return;
+    modhost_frame(host);
+    if (dev_mode) {
+        /* BB_MODS_DEV: report the sync point's rate once, to confirm it runs per frame. */
+        static time_t start;
+        static unsigned calls;
+        static int reported;
+        if (!start) start = time(NULL);
+        ++calls;
+        if (!reported && time(NULL) - start >= 10) {
+            printf("Mods: sync point ran %.1f times/s over 10 s (thread %llu)\n", calls / 10.0,
+                   (unsigned long long)sync_thread);
+            reported = 1;
+        }
+    }
+}
