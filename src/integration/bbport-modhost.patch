+// runtime_modhost.c, any thread, under its log lock.
+extern "C" void bbport_modui_log(int level, const char* line) {
+    std::scoped_lock lock{log_mutex};
+    if (log_lines.size() >= 300) log_lines.pop_front();
+    log_lines.push_back({level, line});
+}
+
+extern "C" void bbport_modui_fill(modhost_ui_backend* ui) {
+    ui->user = nullptr;
+    ui->begin_panel = BeginPanel;
+    ui->end_panel = EndPanel;
+    ui->text = Text;
+    ui->button = Button;
+    ui->checkbox = Checkbox;
+    ui->slider_float = SliderFloat;
+    ui->separator = Separator;
+    ui->same_line = SameLine;
+    ui->notify = Notify;
+    ui->imgui_context = Context;
+    ui->slider_int = SliderInt;
+    ui->input_text = InputText;
+    ui->collapsing_header = CollapsingHeader;
+    ui->combo = Combo;
+    ui->text_colored = TextColored;
+    ui->push_scope = PushScope;
+    ui->pop_scope = PopScope;
+    ui->table_begin = TableBegin;
+    ui->table_next_row = TableRow;
+    ui->table_next_column = TableColumn;
+    ui->table_end = TableEnd;
+}
+
+namespace BbModUi {
+
+bool TryBeginFrame(bool menu_open) {
+    modhost* h = runtime_modhost_get();
+    return !menu_open || !h || modhost_try_lock(h);
+}
+
+void EndFrame(bool menu_open) {
+    modhost* h = runtime_modhost_get();
+    if (menu_open && h) modhost_unlock(h);
+}
+
+bool Visible() {
+    if (LayersActive()) return true;
+    std::scoped_lock lock{toast_mutex};
+    return !toasts.empty();
+}
+
+bool Captures() {
+    modhost* h = runtime_modhost_get();
+    return h && modhost_ui_captures(h) != 0;
+}
+
+bool LayersActive() {
+    modhost* h = runtime_modhost_get();
+    return h && modhost_ui_active(h) != 0;
+}
+
+void Input(unsigned action) {
+    if (modhost* h = runtime_modhost_get()) modhost_ui_input(h, action);
+}
+
+void SetFrameSize(unsigned width, unsigned height) {
+    if (width && height) { frame_w = width; frame_h = height; }
+}
+
+void Draw(bool menu_open) {
+    modhost* h = runtime_modhost_get();
+    if (!h) return;
+    RefreshLayers(h);
+    DrawLayers();
+    if (menu_open && modhost_try_lock(h)) {
+        ModsWindow(h);
+        modhost_draw_panels(h);
+        modhost_unlock(h);
+    }
+    if (menu_open) LogWindow();
+    Toasts();
+}
+
+} // namespace BbModUi
