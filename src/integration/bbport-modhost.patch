+static bbm_status mod_text_begin(void*u,const bbm_text_request*r,uint64_t*t){
+    (void)u;return runtime_text_begin(r->initial,r->title,r->max_bytes,t);
+}
+static bbm_status mod_text_poll(void*u,uint64_t t,bbm_text_result*r){
+    (void)u;int state=runtime_text_poll(t,r->text,sizeof r->text);
+    if(state<0)return state;
+    r->size=sizeof *r;r->state=(uint32_t)state;r->status=BBM_OK;return BBM_OK;
+}
+static void mod_text_cancel(void*u,uint64_t t){(void)u;runtime_text_cancel(t);}
