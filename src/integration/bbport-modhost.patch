 #include "runtime.h"
 #include "gpu/bbgpu.h"
 #include "runtime_input_config.h"
+#include "runtime_modhost.h"
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
@@ -742,6 +743,9 @@ static ABI int32_t pad_read_state(int32_t handle, PadData *data) {
     pthread_mutex_lock(&lock);
     sample(data); ++reads;
