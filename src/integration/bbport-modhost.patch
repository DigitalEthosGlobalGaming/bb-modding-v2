diff --git a/src/runtime_haptics.inc b/src/runtime_haptics.inc
new file mode 100644
index 0000000..baac997
--- /dev/null
+++ b/src/runtime_haptics.inc
@@ -0,0 +1,75 @@
+/* USB DualSense actuator audio. Included by runtime_pad.c; all calls hold lock.
+ * Finite clips, no mod callbacks or borrowed buffers on the audio thread.
+ * Four-channel layout: silent front pair, left/right actuators on rear pair.
+ * References: SDL issue #9197 and SDL_hidapi_ps5.c (zero rumble restores audio).
+ */
+static SDL_AudioStream *grip_stream;
+static SDL_JoystickID grip_pad;
+static uint64_t grip_until_ms, grip_retry_ms;
+static void grip_close(void) {
+    if (grip_stream) SDL_DestroyAudioStream(grip_stream);
+    grip_stream=NULL; grip_pad=0; grip_until_ms=0;
+}
+static int grip_open(SDL_Gamepad *g) {
+    if (grip_stream && grip_pad==SDL_GetGamepadID(g)) return 0;
+    grip_close();
+    uint64_t now=SDL_GetTicks();
+    if (now<grip_retry_ms) return -1;
+    grip_retry_ms=now+3000;
+    if (!SDL_WasInit(SDL_INIT_AUDIO) && !SDL_InitSubSystem(SDL_INIT_AUDIO)) return -1;
+    /* Never choose a default output. Reject ambiguity (including multiple pads).
+     * Name+quad layout is a conservative single-controller heuristic, not USB
+     * container identity matching. Renamed endpoints fail closed. */
+    int count=0, pads=0;
+    SDL_JoystickID *ids=SDL_GetGamepads(&count);
+    for (int i=0; ids && i<count; ++i)
+        if (SDL_GetGamepadTypeForID(ids[i])==SDL_GAMEPAD_TYPE_PS5) ++pads;
+    SDL_free(ids);
+    if (pads!=1) return -1;
+    SDL_AudioDeviceID chosen=0;
+    SDL_AudioDeviceID *devices=SDL_GetAudioPlaybackDevices(&count);
+    int matches=0;
+    for (int i=0; devices && i<count; ++i) {
+        const char *name=SDL_GetAudioDeviceName(devices[i]);
+        SDL_AudioSpec format;
+        if (name && (SDL_strcasestr(name,"Wireless Controller") || SDL_strcasestr(name,"DualSense")) &&
+            SDL_GetAudioDeviceFormat(devices[i],&format,NULL) && format.channels==4) {
+            chosen=devices[i]; ++matches;
+        }
+    }
+    SDL_free(devices);
+    if (matches!=1) return -1;
+    SDL_AudioSpec source={SDL_AUDIO_F32,4,48000};
+    grip_stream=SDL_OpenAudioDeviceStream(chosen,&source,NULL,NULL);
+    SDL_AudioSpec actual;
+    if (!grip_stream || !SDL_GetAudioDeviceFormat(SDL_GetAudioStreamDevice(grip_stream),&actual,NULL) || actual.channels!=4) {
+        grip_close(); return -1;
+    }
+    grip_pad=SDL_GetGamepadID(g); grip_retry_ms=0;
+    printf("Runtime: DualSense USB grip haptics: %s\n",SDL_GetAudioDeviceName(chosen));
+    return 0;
+}
+static int grip_play(SDL_Gamepad *g,const float *stereo,uint32_t frames) {
+    if (!frames) { grip_close(); return 0; }
+    if (!g || SDL_GetGamepadType(g)!=SDL_GAMEPAD_TYPE_PS5 ||
+        SDL_GetGamepadConnectionState(g)!=SDL_JOYSTICK_CONNECTION_WIRED ||
+        frames>12000 || !stereo || grip_open(g)) return -1;
+    SDL_AudioSpec actual;
+    if (!SDL_GetAudioDeviceFormat(SDL_GetAudioStreamDevice(grip_stream),&actual,NULL) || actual.channels!=4) {
+        grip_close(); return -1;
+    }
+    float quad[12000*4];
+    for (uint32_t i=0;i<frames;++i) {
+        float l=stereo[i*2],r=stereo[i*2+1];
+        if (!isfinite(l)||!isfinite(r)||fabsf(l)>0.5f||fabsf(r)>0.5f) return -1;
+        quad[i*4]=quad[i*4+1]=0; quad[i*4+2]=l; quad[i*4+3]=r;
+    }
+    /* Clear SDL's rumble state so later LED sends don't disable audio haptics. */
+    if (!SDL_RumbleGamepad(g,0,0,0) || !SDL_ClearAudioStream(grip_stream) ||
+        !SDL_PutAudioStreamData(grip_stream,quad,(int)(frames*4*sizeof(float))) ||
+        !SDL_FlushAudioStream(grip_stream) || !SDL_ResumeAudioStreamDevice(grip_stream)) {
+        grip_close(); return -1;
+    }
+    grip_until_ms=SDL_GetTicks()+(frames+47)/48+30;
+    return 0;
+}
diff --git a/src/runtime_ime.inc b/src/runtime_ime.inc
new file mode 100644
index 0000000..b2452da
--- /dev/null
+++ b/src/runtime_ime.inc
@@ -0,0 +1,80 @@
+/* ImeDialog: text typed on the keyboard into the game window (title bar shows it).
+ * OrbisImeDialogParam: user, type, languages(8), enter label, method, filter,
+ * option, max length, char16 buffer, position, alignment, placeholder, title. */
+typedef struct {
+    int32_t user; uint32_t type; uint64_t languages; uint32_t enter_label, input_method;
+    void *filter; uint32_t option, max_length; uint16_t *buffer;
+    float x, y; uint32_t halign, valign; const uint16_t *placeholder, *title; int8_t reserved[16];
+} ImeParam;
+static struct { int running, finished, end_status; uint16_t *buffer; uint32_t max_length; uint64_t token; } ime;
+static pthread_mutex_t ime_lock=PTHREAD_MUTEX_INITIALIZER;
+static size_t utf16_to_utf8(const uint16_t *in, size_t limit, char *out, size_t size) {
+    size_t n=0;
+    for (size_t i=0; in && i<limit && in[i] && n+4<size; ++i) {
+        uint32_t c=in[i];
+        if (c>=0xD800 && c<0xDC00 && i+1<limit && in[i+1]>=0xDC00 && in[i+1]<0xE000) { c=0x10000+((c-0xD800)<<10)+(in[i+1]-0xDC00); ++i; }
+        if (c<0x80) out[n++]=(char)c;
+        else if (c<0x800) { out[n++]=(char)(0xC0|c>>6); out[n++]=(char)(0x80|(c&63)); }
+        else if (c<0x10000) { out[n++]=(char)(0xE0|c>>12); out[n++]=(char)(0x80|((c>>6)&63)); out[n++]=(char)(0x80|(c&63)); }
+        else { out[n++]=(char)(0xF0|c>>18); out[n++]=(char)(0x80|((c>>12)&63)); out[n++]=(char)(0x80|((c>>6)&63)); out[n++]=(char)(0x80|(c&63)); }
+    }
+    out[n]=0; return n;
+}
+static void utf8_to_utf16(const char *in, uint16_t *out, uint32_t max) {
+    uint32_t n=0;
+    for (const unsigned char *p=(const unsigned char *)in; *p && n<max;) {
+        uint32_t c; int extra;
+        if (*p<0x80) { c=*p; extra=0; } else if ((*p&0xE0)==0xC0) { c=*p&31; extra=1; }
+        else if ((*p&0xF0)==0xE0) { c=*p&15; extra=2; } else { c=*p&7; extra=3; }
+        ++p;
+        for (int k=0;k<extra && (*p&0xC0)==0x80;++k) c=(c<<6)|(*p++&63);
+        if (c>=0x10000) { if (n+2>max) break; c-=0x10000; out[n++]=(uint16_t)(0xD800+(c>>10)); out[n++]=(uint16_t)(0xDC00+(c&1023)); }
+        else out[n++]=(uint16_t)c;
+    }
+    out[n<max ? n : max]=0;
+}
+static void ime_complete(int end_status, const char *text) {
+    if (!end_status && ime.buffer && ime.max_length) utf8_to_utf16(text,ime.buffer,ime.max_length);
+    ime.end_status=end_status; ime.finished=1; ime.running=0;
+    printf("Runtime: ImeDialog %s%s%s\n",end_status ? "cancelled" : "text: ",end_status ? "" : text,"");
+}
+static int32_t ime_init_locked(const ImeParam *param, const void *extended) {
+    (void)extended;
+    if (!param || !param->buffer || !param->max_length) return (int32_t)0x80BC0004; /* IME INVALID_ADDRESS */
+    if (ime.running) return (int32_t)0x80BC0003;                                  /* BUSY */
+    memset(&ime,0,sizeof(ime));
+    ime.buffer=param->buffer; ime.max_length=param->max_length; ime.running=1;
+    char initial[512], prompt[256];
+    utf16_to_utf8(param->buffer,param->max_length,initial,sizeof(initial));
+    utf16_to_utf8(param->title,128,prompt,sizeof(prompt));
+    const char *preset=getenv("BB_IME_TEXT");
+    if (preset) { ime_complete(0,preset); return 0; }
+    /* An empty field starts with the player name (launcher) or "Hunter": a controller alone
+     * can accept it (the port has no on-screen keyboard). */
+    const char *name=getenv("BB_USER_NAME");
+    const char *start=initial[0] ? initial : name && *name ? name : "Hunter";
+    int rc=runtime_text_begin(start,prompt[0] ? prompt : "Text",0,&ime.token);
+    if(rc==-3){memset(&ime,0,sizeof ime);return (int32_t)0x80BC0003;}
+    if(rc) ime_complete(0,start);
+    else printf("Runtime: ImeDialog opened: shown on screen; keyboard Enter or Cross accepts, Esc or Circle cancels\n");
+    return 0;
+}
+static int32_t ime_status_locked(void) {
+    if (ime.running) {
+        char text[512];
+        int state=runtime_text_poll(ime.token,text,sizeof(text));
+        if (state) ime_complete(state==1 ? 0 : 1,text);
+    }
+    return ime.running ? 1 : ime.finished ? 2 : 0; /* Running / Finished / None */
+}
+static int32_t ime_result_locked(uint32_t *result) {
+    if (!ime.finished) return (int32_t)0x80BC0101; /* DIALOG NOT_FINISHED */
+    if (result) *result=(uint32_t)ime.end_status;
+    return 0;
+}
+static int32_t ime_term_locked(void) { runtime_text_cancel(ime.token);memset(&ime,0,sizeof(ime));return 0; }
+static ABI int32_t ime_init(const ImeParam*p,const void*e){pthread_mutex_lock(&ime_lock);int32_t rc=ime_init_locked(p,e);pthread_mutex_unlock(&ime_lock);return rc;}
+static ABI int32_t ime_status(void){pthread_mutex_lock(&ime_lock);int32_t rc=ime_status_locked();pthread_mutex_unlock(&ime_lock);return rc;}
+static ABI int32_t ime_result(uint32_t*r){pthread_mutex_lock(&ime_lock);int32_t rc=ime_result_locked(r);pthread_mutex_unlock(&ime_lock);return rc;}
+static ABI int32_t ime_term(void){pthread_mutex_lock(&ime_lock);int32_t rc=ime_term_locked();pthread_mutex_unlock(&ime_lock);return rc;}
+
diff --git a/src/runtime_modhost.c b/src/runtime_modhost.c
new file mode 100644
index 0000000..603a217
--- /dev/null
+++ b/src/runtime_modhost.c
@@ -0,0 +1,260 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Native code mods (bbmod, third_party/bbmod): the glue between bbport and the
+ * mod host. Built with -DBB_MODHOST (gpu/CMakeLists.txt, on when
+ * third_party/bbmod is present); without it every function here is a no-op.
+ *
+ *   BB_CODEMODS_DIR   mod folder (run.py: <data>/bbmods; default ./bbmods)
+ *   BB_MODS_DEV=1     watch mod DLLs and hot reload them when they change
+ *   BB_MODS_SAFE=1    discover mods but load none (a mod crashes at start)
+ *   BB_MODHOST=0      no mod host at all
+ *   BB_MODS_LOG       log file (default: <mods folder>.log, e.g. bbmods.log; the previous
+ *                     run's is kept as bbmods.prev.log). Every host and mod line, debug
+ *                     included, timestamped and flushed per line.
+ *
+ * Sync point: the game's pad poll (scePadReadState), on the first thread that
+ * polls. Mod frame callbacks, reloads and network events run there, once per
+ * poll, outside the pad lock. */
+#include "runtime.h"
+#include "runtime_modhost.h"
+#include "runtime_text_input.h"
+
+#ifdef BB_MODHOST
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <pthread.h>
+#include <SDL3/SDL.h>
+#include "gpu/bbgpu.h"
+#include "modhost.h"
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+static uint64_t thread_id(void) { return GetCurrentThreadId(); }
+#else
+#include <pthread.h>
+static uint64_t thread_id(void) { return (uint64_t)(uintptr_t)pthread_self(); }
+#endif
+
+void bbport_modui_fill(modhost_ui_backend *ui);     /* gpu/shim/bbport_modui.cpp */
+void bbport_modui_log(int level, const char *line); /* its in-game log window */
+
+static modhost *host;
+static uint64_t sync_thread;
+static volatile uint32_t pad_buttons;
+static int dev_mode;
+
+static FILE *log_file;
+static char log_path[1100];
+static pthread_mutex_t log_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static void open_log(const char *dir) {
+    const char *p = getenv("BB_MODS_LOG");
+    if (p && *p) snprintf(log_path, sizeof(log_path), "%s", p);
+    else snprintf(log_path, sizeof(log_path), "%s.log", dir);
+    char prev[1200];
+    snprintf(prev, sizeof(prev), "%.*s.prev.log", (int)(strlen(log_path) > 4 ? strlen(log_path) - 4 : strlen(log_path)), log_path);
+    remove(prev);
+    rename(log_path, prev);
+    log_file = fopen(log_path, "w");
+    if (log_file) {
+        time_t now = time(NULL);
+        char when[64];
+        strftime(when, sizeof(when), "%Y-%m-%d %H:%M:%S", localtime(&now));
+        fprintf(log_file, "bbport code mods log, started %s\n", when);
+        fflush(log_file);
+    }
+}
+
+/* Any thread (game, overlay, mod workers): one lock for the file, console and window. */
+static void log_line(void *user, const char *mod_id, int level, const char *msg) {
+    (void)user;
+    static const char *names[] = {"debug", "info", "warn", "error"};
+    int hh, mm, ss, ms;
+#ifdef _WIN32
+    SYSTEMTIME st;
+    GetLocalTime(&st);
+    hh = st.wHour; mm = st.wMinute; ss = st.wSecond; ms = st.wMilliseconds;
+#else
+    struct timespec ts;
+    clock_gettime(CLOCK_REALTIME, &ts);
+    time_t secs = ts.tv_sec;
+    struct tm tm_now = *localtime(&secs);
+    hh = tm_now.tm_hour; mm = tm_now.tm_min; ss = tm_now.tm_sec; ms = (int)(ts.tv_nsec / 1000000);
+#endif
+    char line[1400];
+    snprintf(line, sizeof(line), "%02d:%02d:%02d.%03d [%s] %s%s%s", hh, mm, ss, ms, names[level & 3],
+             mod_id ? mod_id : "host", mod_id ? ": " : "", msg);
+    pthread_mutex_lock(&log_lock);
+    if (log_file) {
+        fputs(line, log_file);
+        fputc('\n', log_file);
+        fflush(log_file); /* survives a crash */
+    }
+    if (level >= BBM_LOG_INFO || dev_mode) {
+        printf("Mods: %s\n", line + 13);
+        fflush(stdout);
+    }
+    bbport_modui_log(level, line);
+    pthread_mutex_unlock(&log_lock);
+}
+
+const char *runtime_modhost_log_path(void) { return log_path; }
+
+/* A crash inside mod code during a host call jumps back here (probe.c's fault
+ * handler resumes the thread through runtime_fault_recover), and only that mod
+ * is disabled. */
+static int call_guarded(void *user, void (*fn)(void *), void *arg) {
+    (void)user;
+    sigjmp_buf buffer;
+    sigjmp_buf *volatile previous = runtime_fault_recover;
+    if (sigsetjmp(buffer, 1)) {
+        runtime_fault_recover = previous;
+        return 1;
+    }
+    runtime_fault_recover = &buffer;
+    fn(arg);
+    runtime_fault_recover = previous;
+    return 0;
+}
+
+static const uint8_t *keyboard(void *user, int *count) {
+    (void)user;
+    if (bbgpu_overlay_captures_input() || !SDL_WasInit(SDL_INIT_VIDEO)) return NULL;
+    return (const uint8_t *)SDL_GetKeyboardState(count); /* bool[], one byte each */
+}
+
+static uint32_t pad(void *user) {
+    (void)user;
+    return __atomic_load_n(&pad_buttons, __ATOMIC_RELAXED);
+}
+
+extern int runtime_pad_haptics(void *, const float *, uint32_t);
+extern int runtime_pad_effect_info(void *, bbm_pad_info *);
+extern int runtime_pad_effect_send(void *, const uint8_t *, const uint8_t *);
+extern int runtime_pad_effect_led(void *, uint8_t, uint8_t, uint8_t);
+static int pad_captured(void *user) { (void)user; return bbgpu_overlay_captures_input(); }
+static void reset_pad_at_exit(void) {
+    const uint8_t off[11] = {5};
+    runtime_pad_haptics(NULL, NULL, 0);
+    runtime_pad_effect_send(NULL, off, off);
+}
+
+static int env_on(const char *name) {
+    const char *v = getenv(name);
