+/* Actual shared lease service with an explicit fake window-thread ack. */
+#include "runtime_text_input.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include <pthread.h>
+static int available=1,state,cancel_pending,cancels;
+static char text[4096];
+int bbgpu_text_input_begin_limited(const char*initial,const char*title,uint32_t max){
+    assert(title&&(!max||strlen(initial)<=max));if(!available)return 0;
+    snprintf(text,sizeof text,"%s",initial);state=0;cancel_pending=0;return 1;
+}
+void bbgpu_text_input_cancel(void){state=0;cancel_pending=1;cancels++;}
+int bbgpu_text_input_poll(char*out,uint64_t size){if(out&&size)snprintf(out,(size_t)size,"%s",text);return cancel_pending?0:state;}
+static void ack(void){assert(cancel_pending);cancel_pending=0;state=2;}
+static void *contend(void *out){uint64_t *token=out;int rc=runtime_text_begin("","Concurrent",127,token);assert(rc==0||rc==-3);return NULL;}
+int main(void){
+    uint64_t game,mod,next;char result[4096];
+    assert(!runtime_text_begin("Hunter","Game IME",0,&game));
+    assert(runtime_text_begin("Setting","Mod dialog",127,&mod)==-3&&mod==0);
+    runtime_text_cancel(game);assert(cancels==1);
+    state=1; /* an Enter event already in flight is not a cancellation ack */
+    assert(runtime_text_begin("Setting","Mod dialog",127,&mod)==-3);
+    ack();assert(!runtime_text_begin("Setting","Mod dialog",127,&mod)&&mod!=game);
+    runtime_text_cancel(game);assert(cancels==1); /* late old cancel is harmless */
+    assert(runtime_text_poll(game,result,sizeof result)==-7);
+    assert(runtime_text_poll(mod,result,sizeof result)==0&&!strcmp(result,"Setting"));
+    strcpy(text,"Unicode \xe2\x9c\x93");state=1;
+    assert(runtime_text_poll(mod,result,sizeof result)==1&&!strcmp(result,text));
+    assert(!runtime_text_begin("","Next",127,&next));
+    runtime_text_cancel(mod);assert(cancels==1);
+    runtime_text_cancel(next);assert(cancels==2);ack();
+    available=0;assert(runtime_text_begin("","Unavailable",127,&next)==-4&&next==0);available=1;
+    for(int i=0;i<20;i++){
+        assert(!runtime_text_begin("","Reload",127,&game));runtime_text_cancel(game);
+        assert(runtime_text_begin("","Replacement",127,&mod)==-3);ack();
+        assert(!runtime_text_begin("","Replacement",127,&mod));runtime_text_cancel(game);
+        state=1;assert(runtime_text_poll(mod,result,sizeof result)==1);
+    }
+    pthread_t threads[8];uint64_t tokens[8]={0};
+    for(int i=0;i<8;i++)assert(!pthread_create(&threads[i],NULL,contend,&tokens[i]));
+    int winners=0;for(int i=0;i<8;i++){assert(!pthread_join(threads[i],NULL));if(tokens[i]){winners++;next=tokens[i];}}
+    assert(winners==1);runtime_text_cancel(next);ack();
+    puts("shared text lease: game/mod exclusion, deferred cancellation ack, stale tokens, 20 reloads and concurrent begin: OK");return 0;
+}
